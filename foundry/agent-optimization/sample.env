# Copy to an untracked .env or pass to scripts with --env-file.
# This file intentionally contains no credentials.
AZURE_ENV_NAME=agent-optimization-workshop
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=
AZURE_AI_DEPLOYMENTS_LOCATION=
AZURE_RESOURCE_GROUP=rg-agent-optimization-workshop
AZURE_AI_ACCOUNT_NAME=
AZURE_AI_PROJECT_NAME=product-launch-studio
ENABLE_HOSTED_AGENTS=true
ENABLE_CAPABILITY_HOST=false
AZD_AGENT_SKIP_ACR=true
ENABLE_MONITORING=true
COPYWRITER_DEPLOYMENT_MODE=fixed

# Exact catalog identifiers, versions, formats, SKUs, and regional quota must be
# verified with scripts/preflight.sh before provisioning.
CAMPAIGN_COORDINATOR_MODEL_NAME=gpt-5.4-mini
CAMPAIGN_COORDINATOR_MODEL_VERSION=
CAMPAIGN_COORDINATOR_MODEL_FORMAT=OpenAI
CAMPAIGN_COORDINATOR_MODEL_SKU=GlobalStandard

VISUAL_UNDERSTANDING_MODEL_NAME=claude-sonnet-6
VISUAL_UNDERSTANDING_MODEL_VERSION=
VISUAL_UNDERSTANDING_MODEL_FORMAT=Anthropic
VISUAL_UNDERSTANDING_MODEL_SKU=GlobalStandard
VISUAL_UNDERSTANDING_FALLBACK_MODEL_NAME=gpt-5.4
VISUAL_UNDERSTANDING_FALLBACK_MODEL_VERSION=
VISUAL_UNDERSTANDING_FALLBACK_MODEL_FORMAT=OpenAI
VISUAL_UNDERSTANDING_FALLBACK_MODEL_SKU=GlobalStandard

CAMPAIGN_REASONING_MODEL_NAME=gpt-5.4
CAMPAIGN_REASONING_MODEL_VERSION=
CAMPAIGN_REASONING_MODEL_FORMAT=OpenAI
CAMPAIGN_REASONING_MODEL_SKU=GlobalStandard

# The workshop starts fixed, then scripts/switch-router.* remaps this deployment.
ADAPTIVE_COPY_MODEL_NAME=gpt-5.4-mini
ADAPTIVE_COPY_MODEL_VERSION=
ADAPTIVE_COPY_MODEL_FORMAT=OpenAI
ADAPTIVE_COPY_MODEL_SKU=GlobalStandard
MODEL_ROUTER_MODEL_NAME=model-router
MODEL_ROUTER_MODEL_VERSION=
MODEL_ROUTER_MODEL_FORMAT=OpenAI
MODEL_ROUTER_MODEL_SKU=GlobalStandard

CREATIVE_IMAGE_MODEL_NAME=MAI-Image-2.5
CREATIVE_IMAGE_MODEL_VERSION=
CREATIVE_IMAGE_MODEL_FORMAT=Microsoft
CREATIVE_IMAGE_MODEL_SKU=GlobalStandard
